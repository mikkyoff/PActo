# ============================================================
# POCKET OPTION
# ============================================================

# Put your Pocket Option SSID here when testing locally.
#
# DO NOT commit your real SSID to GitHub.
#
POCKET_OPTION_SSID=PUT_YOUR_SSID_HERE


# ============================================================
# TRADING
# ============================================================

# AUDUSD OTC
ASSET=AUDUSD_otc

# 15-second candles
TIMEFRAME_SECONDS=15

# Trade amount
TRADE_AMOUNT=2500

# One candle expiry
EXPIRY_SECONDS=15


# ============================================================
# SUPPORT / RESISTANCE
# ============================================================

# Number of closed candles used for S/R.
LOOKBACK_WINDOW=50

# Fractal strength.
#
# 3 means a pivot must exceed the 3 candles
# on each side.
PIVOT_STRENGTH=3

# Pivot clustering tolerance.
#
# 0.75 x average candle range.
ZONE_TOLERANCE_AVG_RANGE=0.75

# Minimum touches for a tradable zone.
MIN_ZONE_TOUCHES=2

# Maximum touches before zone is ignored.
MAX_ZONE_TOUCHES=4


# ============================================================
# DOJI SETTINGS
# ============================================================

# 10% maximum body.
DOJI_BODY_MAX_PCT=0.10

# 60% minimum wick.
DOJI_WICK_MIN_PCT=0.60


# ============================================================
# SHOOTING STAR / HAMMER
# ============================================================

# Maximum body size.
STAR_HAMMER_BODY_MAX_PCT=0.30

# Wick must be at least 2x body.
STAR_HAMMER_WICK_MULTIPLIER=2.0


# ============================================================
# RANGE FILTER
# ============================================================

# C0 must have at least 0.5x the average range.
MIN_RANGE_AVG_MULTIPLIER=0.5


# ============================================================
# TREND GATE
# ============================================================

TREND_CANDLES=3


# ============================================================
# SAFETY
# ============================================================

# IMPORTANT:
#
# false = DEMO ONLY
#
# The bot will refuse to trade a LIVE account
# while this is false.

LIVE_TRADING=false


# ============================================================
# OPTIONAL TESTING LIMITS
# ============================================================

# 0 = unlimited.
MAX_TRADES=0

# 0 = disabled.
MAX_CONSECUTIVE_TRADES=0


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
